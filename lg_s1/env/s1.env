# ---------------------------------------------------------------------------------------------
# Stage S1 environment.  Sourced by s1ctl.py (python) and slurm/common.sh (bash).
# Edit the paths once; every script reads them from here.  `export` is required for bash users.
# ---------------------------------------------------------------------------------------------

# --- who / where ------------------------------------------------------------------------------
export LG_USER=212aig08
export LG_HOME=/home3/212aig08                         # quota root (1000 GB)
export LG_S1_ROOT=/home/212aig08/lg_s1                 # where this package is unzipped
export LG_OUT=/home3/212aig08/lg_s1_out                # all S1 outputs (rows, reports, logs)

# --- existing assets to verify (D1, report §4.3) -----------------------------------------------
export LG_V04_ROOT=/home/212aig08/landmark_guard_mlsys                 # v0.4 code (adapter target)
export LG_V04_RUNS=/home/212aig08/lg_mlsys_v04_runs
export LG_PAPER_ROOT=/home3/212aig08/servsec/exp/lmguard/poc/codex/landmark_guard_paper
export LG_DATA_V1=${LG_PAPER_ROOT}/data                                 # download_v1 / screened_v1 / conflict_clean_v1
export LG_EXTERNAL_CODE=/home/212aig08/landmark_guard_external
export LG_EXTERNAL_DATA=/home/212aig08/lg_external_v01                  # audited/, fetch_status.json, overlap.sqlite
export LG_06B_DATA_SYMLINK=/home/212aig08/landmark_guard/runs/paper_conflict_v1/0.6B_random_edges_s0/data
export LG_ROUND3_ROOT=                                                  # fill in once confirmed (results_r3/, data_clean/)

# --- Hugging Face cache (unified: compute nodes have no /scratch and no network) ----------------
export HF_HOME=${LG_HOME}/.cache/huggingface
export HF_HUB_CACHE=${HF_HOME}/hub
export HF_DATASETS_CACHE=${HF_HOME}/datasets
export TOKENIZERS_PARALLELISM=false
# HF_TOKEN=hf_...            # needed on the LOGIN node for gated repos (Llama, WildGuardMix, WildChat)

# --- v2 sources (D3 writes sources/<name>/revision.json under here) --------------------------------
export LG_SOURCES=/home3/212aig08/lg_data_v2/sources

# --- python -------------------------------------------------------------------------------------
export LG_PYTHON=/home/212aig08/landmark_guard_mlsys/.venv/bin/python   # falls back to python3 if missing

# --- slurm (QOS normal forces --gres=gpu:1 on GPU partitions) -----------------------------------
export LG_PARTITION=RTX6000ADA
export LG_QOS=normal
export LG_GRES=gpu:1
export LG_NODELIST=                       # e.g. n19,n35,n36,n62 ; empty = any node of the partition
export LG_CPUS=8
export LG_MEM=64G
export LG_TIME_TESTS=01:00:00
export LG_TIME_ZEROSHOT=12:00:00
export LG_LOGIN_HOST=gsai-login-3         # D3 refuses to run anywhere else (compute nodes are offline)
