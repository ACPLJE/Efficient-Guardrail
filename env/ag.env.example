# env/ag.env.example -- copy to env/ag.env (never commit env/ag.env). Sourced by slurm/ag_common.sh.
# Single Python 3.11 venv for all AG work (D-001). AttnTrace (B3) has its own venv (SPEC 13).

export AG_VENV=/home/212aig08/ag_venv/ag311            # created from /home3/212aig08/.local/bin/python3.11 (F-01)
export AG_OUT=${AG_OUT:-/home/212aig08/ag_results}      # $AG_OUT: raw/, processed/, figures/, numbers.json (SPEC 7.1)
export AG_ATTNTRACE_VENV=/home/212aig08/ag_venv/attntrace310
# login-node downloads (slurm/ag_download_login.sh): <name>/revision.json, probe.json, git clones, streamed docs,
# download_status.json, ag_assets_<MMDD>.json. HF models and datasets themselves stay in $HF_HOME.
export AG_SOURCES=/home/212aig08/ag_sources

export HF_HOME=/home/212aig08/.cache/huggingface
export HF_HUB_CACHE=${HF_HOME}/hub
export HF_DATASETS_CACHE=${HF_HOME}/datasets
export TOKENIZERS_PARALLELISM=false
# HF_TOKEN=            # login node only, for gated downloads; leave empty here
